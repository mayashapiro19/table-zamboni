	)
	(text "From datasheet: V_OUT = V_FB * (1+(R1/R2))\n\nV_OUT = 3.3V\nV_FB = 0.6V\nR2 = 100K\n\n3.3V = 0.6V * (1+(R1/100K))\n3.3V/0.6V = 1+(R1/100K)\n(3.3V/0.6V)-1 =(R1/100K)\nR1 = ((3.3V/0.6V)-1)*(100K)\n\n∴ R1 = 450K; R207 = R1"
		(exclude_from_sim no)
		(at 153.67 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "dfd33bdd-ce5e-4ebf-a292-e1bd0ec36787")
	)
